# Installed packages (re-created by `npm install`)
node_modules/

# Build output (re-created by `npm run build`)
dist/

# Saved games written by the server (see DOMINATION_DATA_DIR in README.md):
# data/ by "npm start", data-dev/ by "npm run dev"
/data/
/data-dev/
/data-dev-*/
# Copies of saved games: README.md, "Updating the game", tells whoever runs
# the server to make them (data-before-update, data-of-the-new-version, and
# one per older version that was tried, such as data-of-6bc093c). Every
# folder here whose name starts with "data-" holds saved games and stays
# out of git.
/data-*/

# Test and tooling leftovers
coverage/
.vitest/
test-results/
playwright-report/
e2e/.tmp/
*.tmp
*.log
.vite/
.DS_Store
